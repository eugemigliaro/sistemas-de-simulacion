---
config:
  theme: base
  flowchart:
    curve: linear
    nodeSpacing: 35
    rankSpacing: 55
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "26px"
    primaryColor: "#ffffff"
    primaryTextColor: "#111111"
    primaryBorderColor: "#333333"
    lineColor: "#555555"
---
flowchart LR
    crudos[("Datos crudos<br/>trayectoria.csv<br/>observables.csv")]:::datos -- "lee" --> analisis("Análisis<br/>estadístico<br/><i>tp2analysis</i>"):::script
    analisis -- "escribe" --> procesados[("Datos procesados<br/>summary.csv<br/>blocks.csv")]:::datos
    procesados -- "lee" --> graficado("Graficado y<br/>animación<br/><i>tp2analysis</i>"):::script
    crudos -. "lee para animar" .-> graficado
    graficado -- "genera" --> resultados(["Resultados<br/>finales"]):::resultado

    classDef script fill:#d7f2d2,stroke:#4c9a4c,stroke-width:2px,color:#123a12
    classDef datos fill:#fff6c2,stroke:#c9a227,stroke-width:2px,color:#4a3b00
    classDef resultado fill:#f2e8d5,stroke:#b89b6a,stroke-width:2px,color:#3a2f1a
