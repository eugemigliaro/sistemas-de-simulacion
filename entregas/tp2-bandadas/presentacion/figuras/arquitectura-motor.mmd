---
config:
  theme: base
  flowchart:
    curve: linear
    nodeSpacing: 40
    rankSpacing: 55
  themeVariables:
    fontFamily: "Helvetica, Arial, sans-serif"
    fontSize: "22px"
    primaryColor: "#e8f3f9"
    primaryTextColor: "#111111"
    primaryBorderColor: "#005b91"
    lineColor: "#005b91"
    secondaryColor: "#ffffff"
    tertiaryColor: "#fff4ec"
---
flowchart LR
    runner["<b>Runner</b><br/>run_simulation"]:::orchestrator

    subgraph ciclo[" Ciclo por paso, t = 0 … T "]
        direction LR
        state["<b>Estado S(t)</b><br/>System"]:::data
        cim["<b>Vecinos</b><br/>cell_index_neighbors"]:::process
        obs["<b>Observables</b><br/>v_a , S"]:::process
        dyn["<b>Dinámica</b><br/>advance"]:::process
        next["<b>Estado S(t+1)</b><br/>System"]:::data

        state --> cim
        cim --> obs
        cim --> dyn
        dyn --> next
    end

    geo["Geometría periódica<br/><i>funciones sin estado</i>"]:::service

    runner --> ciclo
    next -. "t + 1 → t" .-> state
    cim -.-> geo
    dyn -.-> geo

    classDef data fill:#ffffff,stroke:#005b91,stroke-width:2px,color:#111111
    classDef process fill:#e8f3f9,stroke:#005b91,stroke-width:2px,color:#111111
    classDef service fill:#fff4ec,stroke:#d35c20,stroke-width:2px,color:#111111
    classDef orchestrator fill:#005b91,stroke:#00364f,stroke-width:2px,color:#ffffff
    style ciclo fill:#ffffff,stroke:#8faabb,stroke-width:1.5px,stroke-dasharray: 4 3
